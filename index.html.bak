<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>科氏力戰術作戰系統 V7.5</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@400;700&family=Noto+Sans+TC:wght@300;400;500;700&display=swap');
        :root { --bg-color:#020617; --text-color:#e2e8f0; --panel-bg:#0f172a; --accent-color:#06b6d4; --border-color:#1e293b; --tactical-green:#22c55e; --tactical-red:#ef4444; }
        body { font-family:'Roboto Mono','Noto Sans TC',monospace; background-color:var(--bg-color); color:var(--text-color); user-select:none; overflow:hidden; }
        body::before { content:" "; position:absolute; top:0; left:0; bottom:0; right:0; background:linear-gradient(rgba(18,16,16,0) 50%,rgba(0,0,0,0.1) 50%),linear-gradient(90deg,rgba(255,0,0,0.02),rgba(0,255,0,0.01),rgba(0,0,255,0.02)); background-size:100% 4px,3px 100%; z-index:100; pointer-events:none; opacity:0.15; }
        canvas { touch-action:none; outline:none; transition:box-shadow 0.3s; }
        .panel-tactical { background-color:rgba(15,23,42,0.9); backdrop-filter:blur(12px); border:1px solid rgba(56,189,248,0.15); box-shadow:inset 0 0 20px rgba(0,0,0,0.5); font-size:1.15rem; }
        .panel-tactical h2 { font-size:1rem; }
        .panel-tactical .value-text { font-size:1.25rem; color:var(--accent-color); font-weight:bold; }
        .panel-tactical .label-text { font-size:0.95rem; color:#cbd5e1; font-weight:500; }
        .panel-tactical .sub-label { font-size:0.7rem; color:#64748b; margin-left:4px; font-weight:normal; }
        .view-controls { position:absolute; bottom:24px; left:50%; transform:translateX(-50%); display:flex; background:rgba(2,6,23,0.95); padding:3px; border-radius:4px; border:1px solid #1e293b; z-index:30; gap:2px; box-shadow:0 0 30px rgba(0,0,0,0.7); }
        .view-btn { padding:6px 16px; font-size:0.7rem; font-weight:700; transition:all 0.2s; display:flex; align-items:center; gap:6px; white-space:nowrap; color:#475569; border:1px solid transparent; text-transform:uppercase; }
        .view-btn.active { color:var(--accent-color); background-color:rgba(6,182,212,0.08); border:1px solid rgba(6,182,212,0.3); }
        .cursor-grab { cursor:grab; } .cursor-grabbing { cursor:grabbing; }
        input[type=range] { -webkit-appearance:none; appearance:none; background:transparent; }
        input[type=range]::-webkit-slider-thumb { -webkit-appearance:none; height:12px; width:12px; background:var(--accent-color); cursor:pointer; margin-top:-4px; box-shadow:0 0 5px var(--accent-color); }
        input[type=range]::-webkit-slider-runnable-track { width:100%; height:4px; cursor:pointer; background:#1e293b; border:1px solid #334155; }
        .legend-overlay { position:absolute; top:20px; left:20px; background:rgba(2,6,23,0.3); backdrop-filter:blur(8px); border-left:3px solid var(--accent-color); padding:12px 16px; border-radius:0 4px 4px 0; z-index:25; font-size:0.85rem; pointer-events:auto; cursor:move; border-top:1px solid rgba(56,189,248,0.05); border-right:1px solid rgba(56,189,248,0.05); border-bottom:1px solid rgba(56,189,248,0.05); }
        .toggle-switch { position:relative; display:inline-block; width:40px; height:20px; }
        .toggle-switch input { opacity:0; width:0; height:0; }
        .slider { position:absolute; cursor:pointer; top:0; left:0; right:0; bottom:0; background-color:#1e293b; transition:.3s; border:1px solid #334155; }
        .slider:before { position:absolute; content:""; height:14px; width:14px; left:2px; bottom:2px; background-color:#475569; transition:.3s; }
        input:checked+.slider { background-color:rgba(6,182,212,0.15); border-color:var(--accent-color); }
        input:checked+.slider:before { transform:translateX(20px); background-color:var(--accent-color); }
        .section-header { display:flex; align-items:center; gap:10px; padding-bottom:8px; margin-bottom:12px; border-bottom:1px solid rgba(56,189,248,0.1); }
        .tactical-grid { background-image:radial-gradient(rgba(6,182,212,0.04) 1px,transparent 1px); background-size:40px 40px; }
        .btn-launch-text { font-size:1.25rem; font-weight:900; letter-spacing:0.15em; }
        .custom-scrollbar::-webkit-scrollbar { width:4px; } .custom-scrollbar::-webkit-scrollbar-track { background:transparent; } .custom-scrollbar::-webkit-scrollbar-thumb { background:#1e293b; border-radius:10px; }
        .rpm-slider-wrap { position:relative; }
        .rpm-slider-wrap .rpm-ticks { display:flex; justify-content:space-between; padding:0 2px; margin-top:4px; }
        .rpm-slider-wrap .rpm-ticks span { font-size:8px; color:#475569; font-family:'Roboto Mono',monospace; }
    </style>
</head>
<body class="h-screen flex flex-col">
    <header class="panel-tactical border-b border-slate-800 flex-none z-20 shadow-2xl">
        <div class="max-w-full px-6 py-3 flex justify-between items-center">
            <div class="flex items-center gap-4">
                <div class="text-cyan-500 flex items-center gap-2"><i class="fa-solid fa-satellite fa-xl animate-pulse"></i><div class="h-10 w-[1px] bg-slate-800 ml-2"></div></div>
                <div>
                    <h1 class="text-lg md:text-xl font-bold tracking-widest text-cyan-50 uppercase">科氏力戰術作戰系統 <span class="text-xs font-normal opacity-50 ml-1">V7.5</span></h1>
                    <p class="text-[10px] text-cyan-700 tracking-[0.2em] uppercase">SEAMLESS VECTOR COORDINATION // OPERATOR: SH-L</p>
                </div>
            </div>
            <div class="flex gap-8 items-center font-mono">
                <div class="px-4 py-1.5 bg-slate-950/80 rounded border border-slate-800 text-[10px] text-cyan-500 flex items-center gap-3"><span class="w-2 h-2 rounded-full bg-cyan-500 animate-ping"></span>COMM LINK: SECURE</div>
                <div class="text-[11px] text-slate-600 hidden sm:block text-right leading-tight uppercase">LATITUDE: <span id="telemetry-lat" class="text-cyan-900">0.00 N</span><br>AZIMUTH: <span id="telemetry-rot" class="text-cyan-900">0.00°</span></div>
            </div>
        </div>
    </header>
    <main class="flex-grow flex flex-col md:flex-row h-full overflow-hidden relative">
        <div class="relative flex-grow flex justify-center items-center overflow-hidden bg-slate-950 tactical-grid" id="canvas-wrapper">
            <div id="legend-box" class="legend-overlay font-mono">
                <div class="text-xs font-bold text-cyan-500 mb-3 tracking-widest uppercase border-b border-cyan-900/40 pb-1">Telemetry Key</div>
                <div class="space-y-2">
                    <div class="flex items-center gap-3"><span class="inline-block w-4 h-3 bg-green-900 border border-green-700 rounded-sm relative"><span class="absolute -top-1 left-1/2 -translate-x-1/2 text-[6px] text-green-400">▲</span></span><span class="text-slate-300 font-bold uppercase text-xs">發射台 PAD</span></div>
                    <div class="flex items-center gap-3"><span class="inline-flex items-center justify-center w-4 h-4"><svg width="14" height="14" viewBox="0 0 14 14"><circle cx="7" cy="7" r="5" fill="none" stroke="#ef4444" stroke-width="2"/><line x1="3" y1="7" x2="11" y2="7" stroke="#ef4444" stroke-width="1.5"/><line x1="7" y1="3" x2="7" y2="11" stroke="#ef4444" stroke-width="1.5"/></svg></span><span class="text-slate-400 font-bold uppercase text-xs">瞄準點 AIM</span></div>
                    <div class="flex items-center gap-3"><span class="text-sm">🦖</span><span class="text-slate-400 font-bold uppercase text-xs">目標 TGT</span></div>
                    <div class="flex items-center gap-3"><span class="w-4 h-0 border-t-2 border-dashed border-yellow-400" style="filter:drop-shadow(0 0 3px rgba(255,220,50,0.5))"></span><span class="text-slate-400 font-bold uppercase text-xs">直線瞄準 AIM-LINE</span></div>
                    <div class="flex items-center gap-3"><span class="w-4 h-1 bg-white/50 rounded-full"></span><span class="text-slate-400 font-bold uppercase text-xs">凝結尾 3S FADE</span></div>
                    <div class="flex items-center gap-3"><span class="w-4 h-0.5 bg-red-600" style="filter:drop-shadow(0 0 3px rgba(239,68,68,0.5))"></span><span class="text-slate-400 font-bold uppercase text-xs">實際軌跡 PERSIST</span></div>
                </div>
            </div>
            <canvas id="simCanvas" class="z-10 shadow-[0_0_80px_rgba(0,0,0,0.9)] cursor-grab"></canvas>
            <div class="view-controls font-mono">
                <button onclick="app.setViewMode(0)" id="view-btn-0" class="view-btn active"><i class="fa-solid fa-satellite"></i> God-View</button>
                <button onclick="app.setViewMode(1)" id="view-btn-1" class="view-btn"><i class="fa-solid fa-compass"></i> Follow-View</button>
            </div>
        </div>
        <div class="panel-tactical w-full md:w-[380px] border-l border-slate-800 flex-none overflow-y-auto z-20 shadow-2xl custom-scrollbar">
            <div class="p-5 space-y-6">
                <div class="space-y-3">
                    <div class="section-header"><i class="fa-solid fa-microchip text-cyan-500 text-xs"></i><h2 class="font-bold tracking-widest text-cyan-100">行星檢視狀態 <span class="sub-label">(System Status)</span></h2></div>
                    <div class="flex gap-1 p-1 bg-slate-950/60 rounded border border-slate-800">
                        <button onclick="app.setDirection(true)" id="hemi-n" class="flex-1 py-2 text-xs font-bold rounded bg-cyan-600/10 text-cyan-400 border border-cyan-500/20 transition-all uppercase">北半球 <span class="sub-label">(North)</span></button>
                        <button onclick="app.setDirection(false)" id="hemi-s" class="flex-1 py-2 text-xs font-bold rounded text-slate-700 hover:text-slate-400 transition-all uppercase">南半球 <span class="sub-label">(South)</span></button>
                    </div>
                    <div class="bg-slate-900/50 p-4 rounded border border-slate-800/40 cursor-pointer" title="雙擊此區域歸零" id="rpm-container">
                        <div class="flex justify-between items-end mb-3 pointer-events-none"><span class="label-text">自轉速度 <span class="sub-label">(Rotation Velocity)</span></span><span id="val-rpm" class="value-text">0.70 RPM</span></div>
                        <div class="rpm-slider-wrap">
                            <input type="range" id="input-rpm" min="0" max="100" step="1" value="21" class="w-full">
                            <div class="rpm-ticks"><span>0</span><span>1</span><span>3</span><span>5</span><span>8</span><span>11</span><span>15</span></div>
                        </div>
                        <div class="text-[9px] text-slate-600 mt-2 text-center tracking-tighter uppercase pointer-events-none">Double click to reset to 0 RPM</div>
                    </div>
                </div>
                <div class="space-y-3">
                    <div class="section-header"><i class="fa-solid fa-crosshairs text-cyan-500 text-xs"></i><h2 class="font-bold tracking-widest text-cyan-100">戰術部署 <span class="sub-label">(Deployment)</span></h2></div>
                    <div class="bg-slate-900/50 p-4 rounded border border-slate-800/40 space-y-5">
                        <div><div class="flex justify-between items-end mb-2"><span class="label-text">起點緯度半徑 <span class="sub-label">(Start Latitude)</span></span><span id="val-radius" class="value-text">0%</span></div><input type="range" id="input-radius" min="0" max="100" step="1" value="0" class="w-full"></div>
                        <div><div class="flex justify-between items-end mb-2"><span class="label-text">推進力道 <span class="sub-label">(Thrust Level)</span></span><span id="val-speed" class="value-text">Lv.3.0</span></div><input type="range" id="input-speed" min="1" max="10" step="0.5" value="3" class="w-full"></div>
                    </div>
                    <div class="bg-slate-950/40 p-4 rounded border border-slate-800/40 space-y-4">
                        <div class="flex items-center justify-between"><span class="label-text">顯示瞄準線 <span class="sub-label">(Show Aim-Line)</span></span><label class="toggle-switch"><input type="checkbox" id="toggle-aim" checked><span class="slider"></span></label></div>
                        <div class="flex items-center justify-between border-t border-slate-800 pt-3"><span class="label-text">顯示地表軌跡 <span class="sub-label">(Show Ground-Track)</span></span><label class="toggle-switch"><input type="checkbox" id="toggle-ground"><span class="slider"></span></label></div>
                    </div>
                </div>
                <div class="pt-2 space-y-3">
                    <button onclick="app.launch()" class="w-full py-5 bg-red-600 hover:bg-red-500 border-b-4 border-red-800 text-white shadow-xl flex items-center justify-center gap-4 transition-all active:translate-y-1 active:border-b-0 group"><i class="fa-solid fa-rocket fa-lg animate-pulse"></i><span class="btn-launch-text">立即發射 <span class="text-xs font-normal opacity-70">(LAUNCH)</span></span></button>
                    <button onclick="app.reset()" class="w-full py-2.5 bg-slate-900/50 text-slate-500 hover:text-red-400 text-xs font-bold rounded border border-slate-800 transition-colors uppercase tracking-[0.2em]">Emergency System Reset</button>
                </div>
                <div class="p-3 bg-black/50 rounded-sm border border-slate-800 text-[10px] text-slate-700 leading-tight font-mono h-24 overflow-hidden">
                    <div id="console-output">> INITIALIZING BALLISTIC MODULE V7.5...<br>> LEGEND ICONS: SYNCED<br>> LINE SHADOW FX: ACTIVE<br>> TACTICAL EARTH FILTER: ONLINE<br>> STATUS: STANDING BY.</div>
                </div>
            </div>
        </div>
    </main>
    <script>
/* Build Status: Hardened & Secure */
